/* Root */

.oort-root {
    background-color: rgb(38, 38, 38);
}

/* Header */

.oort-header {
    height: 58px;
    padding-left: 16px;
    padding-right: 16px;
    margin-bottom: 8px;

    flex-direction: row;
    align-items: center;

    background-color: rgb(48, 48, 48);

    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 28, 28);
}

.oort-header-icon {
    width: 30px;
    height: 30px;
    margin-right: 10px;

    flex-shrink: 0;
}

.oort-header-title {
    flex-grow: 1;

    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(230, 230, 230);
}

/* Content */

.oort-content {
    flex-grow: 1;

    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 16px;
}

/* Section */

.oort-section {
    margin-bottom: 14px;
}

/* Path */

.oort-path-row {
    flex-direction: row;
    align-items: center;

    margin-top: 4px;
}

.oort-path-field {
    flex-grow: 1;

    margin-right: 6px;
}

/* Button */

.oort-small-button {
    min-width: 70px;
    height: 24px;
    margin-left: 3px;
}

.oort-primary-button {
    height: 34px;
    margin-top: 8px;

    -unity-font-style: bold;
}

/* Documentation */

.oort-documentation-build-order-title {
    margin-bottom: 7px;

    -unity-font-style: bold;
}

.oort-documentation-document-list {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;

    background-color: rgb(44, 44, 44);

    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(62, 62, 62);
    border-right-color: rgb(62, 62, 62);
    border-top-color: rgb(62, 62, 62);
    border-bottom-color: rgb(62, 62, 62);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.oort-documentation-document-row {
    height: 23px;

    flex-direction: row;
    align-items: center;
}

.oort-documentation-document-order {
    width: 28px;
    min-width: 28px;

    color: rgb(145, 145, 145);
    -unity-text-align: middle-right;
}

.oort-documentation-document-name {
    margin-left: 10px;

    flex-grow: 1;
    color: rgb(215, 215, 215);
}

.oort-documentation-status {
    margin-top: 12px;

    color: rgb(185, 185, 185);
    white-space: normal;
}

/* Screenshot */

.oort-screenshot-watermark-options {
    margin-left: 14px;
    margin-top: 6px;
}

.oort-screenshot-watermark-preview {
    margin-top: 6px;

    color: rgb(190, 190, 190);
    white-space: normal;
}

.oort-screenshot-watermark-notice {
    margin-top: 4px;

    color: rgb(220, 180, 90);
    white-space: normal;
}

.oort-screenshot-watermark-reset-button {
    margin-top: 6px;

    align-self: flex-end;
}

/* GameObject Icon Generator */

.oort-icon-source-type {
    margin-top: 5px;

    color: rgb(180, 180, 180);
}

.oort-icon-preview-container {
    width: 256px;
    height: 256px;
    margin-top: 7px;

    position: relative;
    align-self: center;

    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(78, 78, 78);
    border-right-color: rgb(78, 78, 78);
    border-top-color: rgb(78, 78, 78);
    border-bottom-color: rgb(78, 78, 78);
}

.oort-icon-preview-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.oort-icon-preview-message {
    position: absolute;
    left: 18px;
    right: 18px;
    top: 0;
    bottom: 0;

    align-items: center;
    justify-content: center;

    color: rgb(225, 225, 225);
    -unity-text-align: middle-center;
    white-space: normal;
}

.oort-icon-reset-button {
    margin-top: 6px;

    align-self: flex-end;
}

.oort-icon-status {
    margin-top: 8px;

    color: rgb(185, 185, 185);
    white-space: normal;
}

/* PlayerPrefs */

.oort-prefs-toolbar {
    flex-direction: row;
    align-items: center;

    margin-bottom: 8px;
}

.oort-prefs-search {
    flex-grow: 1;

    margin-right: 8px;
}

.oort-prefs-list-header {
    height: 28px;

    flex-direction: row;
    align-items: center;

    -unity-font-style: bold;

    border-bottom-width: 1px;
    border-bottom-color: rgb(70, 70, 70);
}

.oort-prefs-sort-button {
    margin-left: 0;
    margin-right: 0;

    background-color: rgba(0, 0, 0, 0);

    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;

    -unity-text-align: middle-left;
}

.oort-prefs-sort-button:hover,
.oort-prefs-sort-button:active,
.oort-prefs-sort-button:focus {
    background-color: rgba(0, 0, 0, 0);
}

.oort-prefs-row {
    width: 100%;
    height: 30px;

    flex-direction: row;
    align-items: center;
}

.oort-prefs-key {
    width: 220px;
    min-width: 220px;

    flex-shrink: 0;

    padding-left: 6px;
}

.oort-prefs-type {
    width: 70px;
    min-width: 70px;

    flex-shrink: 0;
}

.oort-prefs-value {
    min-width: 0;
    margin-right: 6px;

    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

.oort-prefs-action-button {
    width: 68px;
    min-width: 68px;
    margin-left: 4px;

    flex-shrink: 0;
}
