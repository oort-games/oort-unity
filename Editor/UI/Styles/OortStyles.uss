/* Root */

.oort-root {
    background-color: rgb(38, 38, 38);
}


/* Header */

.oort-header {
    height: 58px;
    padding-left: 16px;
    padding-right: 16px;
    margin-bottom: 8px;

    flex-direction: row;
    align-items: center;

    background-color: rgb(48, 48, 48);

    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 28, 28);
}

.oort-header-icon {
    width: 30px;
    height: 30px;
    margin-right: 10px;

    flex-shrink: 0;
}

.oort-header-title {
    flex-grow: 1;

    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(230, 230, 230);
}


/* Content */

.oort-content {
    flex-grow: 1;

    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 16px;
}


/* Section */

.oort-section {
    margin-bottom: 14px;
}


/* Path */

.oort-path-row {
    flex-direction: row;
    align-items: center;

    margin-top: 4px;
}

.oort-path-field {
    flex-grow: 1;

    margin-right: 6px;
}


/* Button */

.oort-small-button {
    min-width: 70px;
    height: 24px;
    margin-left: 3px;
}

.oort-primary-button {
    height: 34px;
    margin-top: 8px;

    -unity-font-style: bold;
}


/* PlayerPrefs */

.oort-prefs-toolbar {
    flex-direction: row;
    align-items: center;

    margin-bottom: 8px;
}

.oort-prefs-search {
    flex-grow: 1;

    margin-right: 8px;
}

.oort-prefs-list-header {
    height: 28px;

    flex-direction: row;
    align-items: center;

    -unity-font-style: bold;

    border-bottom-width: 1px;
    border-bottom-color: rgb(70, 70, 70);
}

.oort-prefs-row {
    width: 100%;
    height: 30px;

    flex-direction: row;
    align-items: center;
}

.oort-prefs-key {
    width: 220px;
    min-width: 220px;

    flex-shrink: 0;

    padding-left: 6px;
}

.oort-prefs-type {
    width: 70px;
    min-width: 70px;

    flex-shrink: 0;
}

.oort-prefs-value {
    min-width: 0;
    margin-right: 6px;

    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

.oort-prefs-action-button {
    width: 68px;
    min-width: 68px;
    margin-left: 4px;

    flex-shrink: 0;
}